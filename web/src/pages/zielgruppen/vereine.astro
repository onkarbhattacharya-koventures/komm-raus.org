---
import MainLayout from '../../layouts/MainLayout.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
---

<MainLayout title="Vereine - Komm Raus">
  <Hero title="Für Vereine" subtitle="Programme für Vereinsmitglieder und Gemeinschaften." image="lagerfeuer-bg" />

  <Section>
    <div class="prose max-w-none">
      <h2>Zielgruppe Vereine</h2>
      <p>Unsere Angebote für Vereine stärken den Zusammenhalt und fördern gemeinsame Erlebnisse. Ideal für Sportvereine, Jugendgruppen und Gemeinschaften.</p>
      <p>Platzhalter für detaillierte Beschreibung der Programme für Vereine.</p>
    </div>
  </Section>
</MainLayout>

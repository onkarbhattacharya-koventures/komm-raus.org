---
import MainLayout from '../../../layouts/MainLayout.astro';
import Hero from '../../../components/Hero.astro';
import Section from '../../../components/Section.astro';
import Card from '../../../components/Card.astro';
---

<MainLayout title="CSR – Komm Raus">
  <Hero title="CSR: Corporate Social Responsibility" subtitle="Engagieren Sie sich nachhaltig für Gesellschaft und Umwelt – mit unseren maßgeschneiderten CSR-Programmen." image="Baumklettern-Seilaufstiegstechnik" />

  <Section>
    <h2>Warum CSR mit Komm Raus?</h2>
    <p>Corporate Social Responsibility (CSR) ist mehr als nur ein Trend – es ist eine Verpflichtung. Unsere Programme helfen Unternehmen, authentische CSR-Initiativen zu entwickeln, die Mitarbeiter motivieren und positive Veränderungen bewirken.</p>
  </Section>

  <Section class="light">
    <h2>Unsere CSR-Schwerpunkte</h2>
    <div class="cards mt-4">
      <Card title="Umweltbildung" body="Sensibilisierung für Nachhaltigkeit und Umweltschutz durch praktische Erlebnisse in der Natur." />
      <Card title="Soziales Engagement" body="Förderung von Teamgeist und sozialer Verantwortung in Gemeinschaftsprojekten." />
      <Card title="Bildung & Entwicklung" body="Unterstützung von Bildungsinitiativen und persönlicher Weiterentwicklung." />
      <Card title="Lokale Partnerschaften" body="Zusammenarbeit mit lokalen Organisationen für nachhaltige Projekte." />
    </div>
  </Section>

  <Section>
    <h2>CSR-Formate für Unternehmen</h2>
    <ul class="list-disc pl-6 space-y-2">
      <li><strong>Team-Volunteering:</strong> Gemeinsame Projekte zur Stärkung des Teamgeists und sozialen Engagements.</li>
      <li><strong>Umweltaktionen:</strong> Praktische Beiträge zum Umweltschutz und zur Nachhaltigkeit.</li>
      <li><strong>Bildungsinitiativen:</strong> Unterstützung von Bildungsprojekten und persönlicher Entwicklung.</li>
      <li><strong>Maßgeschneiderte Programme:</strong> Individuelle CSR-Konzepte nach Ihren Unternehmenswerten.</li>
    </ul>
  </Section>
</MainLayout>

---
import MainLayout from '../../../layouts/MainLayout.astro';
import Hero from '../../../components/Hero.astro';
import Section from '../../../components/Section.astro';
import Card from '../../../components/Card.astro';
---

<MainLayout title="Manager Training – Komm Raus">
  <Hero title="Manager Training: Führungskräfte stärken" subtitle="Entwickeln Sie Ihre Führungsqualitäten in der Natur – authentisch und praxisnah." image="Baumklettern-Seilaufstiegstechnik" />

  <Section>
    <h2>Warum Manager Training im Wald?</h2>
    <p>Unsere Trainings für Führungskräfte nutzen die Herausforderungen der Natur, um echte Führungsqualitäten zu fördern. Hier werden Soft Skills wie Entscheidungsfindung, Teamführung und Stressmanagement in realen Situationen erlebbar.</p>
  </Section>

  <Section class="light">
    <h2>Schwerpunkte des Trainings</h2>
    <div class="cards mt-4">
      <Card title="Führungsstil" body="Entdecken Sie Ihren natürlichen Führungsstil und lernen Sie, ihn situationsgerecht anzupassen." />
      <Card title="Konfliktmanagement" body="Lösen Sie Konflikte konstruktiv und fördern Sie ein positives Arbeitsklima." />
      <Card title="Motivation" body="Inspirieren Sie Ihr Team und steigern Sie die Produktivität durch authentische Motivation." />
      <Card title="Resilienz" body="Bauen Sie Ihre Widerstandskraft gegen Stress auf und bleiben Sie in herausfordernden Zeiten stark." />
    </div>
  </Section>

  <Section>
    <h2>Unsere Formate</h2>
    <ul class="list-disc pl-6 space-y-2">
      <li><strong>Ein-Tages-Workshop:</strong> Intensives Training für schnelle Ergebnisse.</li>
      <li><strong>Zwei-Tages-Seminar:</strong> Tiefgehende Entwicklung mit praktischen Übungen.</li>
      <li><strong>Individuelles Coaching:</strong> Persönliche Begleitung für spezifische Herausforderungen.</li>
    </ul>
  </Section>
</MainLayout>

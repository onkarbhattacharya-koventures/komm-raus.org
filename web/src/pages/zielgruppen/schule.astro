---
import MainLayout from '../../layouts/MainLayout.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
---

<MainLayout title="Schule - Komm Raus">
  <Hero title="Für Schulen" subtitle="Programme speziell für Schulklassen und Bildungseinrichtungen." image="lagerfeuer-bg" />

  <Section>
    <div class="prose max-w-none">
      <h2>Zielgruppe Schule</h2>
      <p>Unsere Programme für Schulen sind darauf ausgelegt, Lernziele mit Abenteuer zu verbinden. Fördern Sie soziale Kompetenzen, Teamgeist und persönliche Entwicklung bei Ihren Schülern.</p>
      <p>Platzhalter für detaillierte Beschreibung der Programme für Schulen.</p>
    </div>
  </Section>
</MainLayout>

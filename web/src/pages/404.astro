---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Seite nicht gefunden – Komm Raus" description="Die gesuchte Seite existiert nicht.">
  <section class="section">
    <div class="container error-container">
      <div class="text-6xl mb-4">😵</div>
      <h1>Seite nicht gefunden</h1>
      <p>Die gesuchte Seite existiert leider nicht.</p>
      <div class="error-actions">
        <a href="/" class="btn btn-primary btn-md">Zur Startseite</a>
        <button onclick="history.back()" class="btn btn-outline btn-md">Zurück</button>
      </div>
    </div>
  </section>
</MainLayout>

<style>
.error-container {
  text-align: center;
  padding: 4rem 1rem;
}

.error-actions {
  display: flex;
  gap: 1rem;
  justify-content: center;
  margin-top: 2rem;
}
</style>

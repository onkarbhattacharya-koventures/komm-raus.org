---
import MainLayout from '../../layouts/MainLayout.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
---

<MainLayout title="Stressresilienz - Komm Raus">
  <Hero title="Stressresilienz" subtitle="Lernen Sie, Stress besser zu bewältigen und Ihre Resilienz zu stärken." image="lagerfeuer-bg" />

  <Section>
    <div class="prose max-w-none">
      <h2>Stressresilienz Training</h2>
      <p>Unsere Programme zur Stressresilienz helfen Ihnen, besser mit Stress umzugehen und Ihre mentale Stärke aufzubauen. Durch Naturerlebnisse und bewährte Methoden entwickeln Sie Strategien für ein ausgeglichenes Leben.</p>
      <p>Platzhalter für detaillierte Beschreibung der Stressresilienz-Programme.</p>
    </div>
  </Section>
</MainLayout>

---
import MainLayout from '../../layouts/MainLayout.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
---

<MainLayout title="Vertrauen - Komm Raus">
  <Hero title="Vertrauen" subtitle="Bauen Sie Vertrauen auf und stärken Sie Beziehungen." image="lagerfeuer-bg" />

  <Section>
    <div class="prose max-w-none">
      <h2>Vertrauens-Programme</h2>
      <p>Unsere Vertrauens-Programme helfen Ihnen, Vertrauen in sich selbst und andere aufzubauen. Durch gemeinsame Erlebnisse und Übungen fördern wir eine vertrauensvolle Atmosphäre.</p>
      <p>Platzhalter für detaillierte Beschreibung der Vertrauens-Programme.</p>
    </div>
  </Section>
</MainLayout>

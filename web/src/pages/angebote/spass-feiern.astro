import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
---

<MainLayout title="Spaß & Feiern - Komm Raus">
  <Hero title="Spaß & Feiern" subtitle="Feiern Sie mit Spaß und Abenteuer." image="lagerfeuer-bg" />

  <Section>
    <div class="prose max-w-none">
      <h2>Spaß & Feiern</h2>
      <p>Unsere Spaß- und Feier-Programme bieten unterhaltsame Aktivitäten für Events und Feiern. Von Spielen bis zu kreativen Workshops.</p>
      <p>Platzhalter für detaillierte Beschreibung von Spaß & Feiern.</p>
    </div>
  </Section>
</MainLayout>

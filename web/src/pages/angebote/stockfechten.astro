---
import MainLayout from '../../layouts/MainLayout.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
---

<MainLayout title="Stockfechten - Komm Raus">
  <Hero title="Stockfechten" subtitle="Lernen Sie die Kunst des Stockfechtens." image="lagerfeuer-bg" />

  <Section>
    <div class="prose max-w-none">
      <h2>Stockfechten</h2>
      <p>Unsere Stockfechten-Kurse vermitteln Ihnen die Grundlagen dieser traditionellen Kampfkunst. Verbessern Sie Ihre Koordination und Selbstverteidigung.</p>
      <p>Platzhalter für detaillierte Beschreibung des Stockfechtens.</p>
    </div>
  </Section>
</MainLayout>

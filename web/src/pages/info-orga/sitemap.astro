<style>
  .sitemap-list {
    list-style: none;
    padding: 0;
  }

  .sitemap-list li {
    margin-bottom: 0.5rem;
  }

  .sitemap-list ul {
    margin-left: 1.5rem;
    list-style: disc;
  }

  .sitemap-list a {
    color: var(--color-secondary);
    text-decoration: none;
  }

  .sitemap-list a:hover {
    text-decoration: underline;
  }
</style>

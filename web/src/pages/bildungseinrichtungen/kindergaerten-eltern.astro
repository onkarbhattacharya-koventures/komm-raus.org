---
import MainLayout from '../../layouts/MainLayout.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
import GlassPanel from '../../components/GlassPanel.astro';
import Button from '../../components/Button.astro';
---

<MainLayout title="Kindergärten & Eltern – Laubfrosch">
  <Hero title="Kindergärten & Eltern" subtitle="Resilienzprotokoll Kids (RP-KIDS) – Wurzeln vor Flügeln." imagePath="/images/bildungseinrichtungen-kindergaerten-soil-table-komm-raus-gmbh-800.jpg" />


  <Section>
    <GlassPanel class="prose max-w-none">
      <h2>Worum es geht</h2>
      <p>Das Resilienzprotokoll Kids (RP-KIDS) versteht den Kindergarten als ersten Übungsraum fürs Leben:</p>
      <ul class="card-list">
        <li>einen Ort, an dem Grundlagen für Gesundheit, Selbstregulation und Lernfreude wachsen</li>
        <li>einen Rahmen, in dem Kinder lernen, ihren Körper, ihre Gefühle und Grenzen wahrzunehmen</li>
        <li>eine Brücke zwischen Kita und Elternhaus</li>
      </ul>
    </GlassPanel>
  </Section>

  <Section>
    <GlassPanel class="prose max-w-none">
      <h2>Ausgangslage: Warum frühe Jahre zählen</h2>
      <ul class="card-list">
        <li>mehr Zeit im Sitzen und in Innenräumen</li>
        <li>mehr Bildschirme und Reize</li>
        <li>weniger freie Bewegung, Natur und verlässliche Rhythmen</li>
        <li>hohe Belastung bei Eltern und pädagogischen Fachkräften</li>
      </ul>
    </GlassPanel>
  </Section>

  <Section>
    <GlassPanel class="prose max-w-none">
      <h2>Das Resilienzprotokoll Kids im Überblick</h2>
      <ul class="card-list">
        <li><strong>Fünf Säulen als Fundament</strong> – Atmung, Schlaf, Bewegung, Ernährung, Denken & Fühlen</li>
        <li><strong>Eine altersgerechte Entwicklungskaskade</strong> – Vom Körper spüren hin zu Resilienz</li>
        <li><strong>Das ganze Dorf</strong> – Erwachsene zuerst</li>
      </ul>
    </GlassPanel>
  </Section>

  <Section>
    <GlassPanel class="prose max-w-none">
      <h2>Die fünf Säulen von RP-KIDS</h2>
      
      <h3>Atmung – „Der innere Wind"</h3>
      <ul class="card-list">
        <li>Puste-Rituale im Morgenkreis</li>
        <li>Gefühlsampel mit Atemritual</li>
        <li>Bauch-Atmen mit Kuscheltier</li>
      </ul>

      <h3>Schlaf & Ruhe – „Die Ruheinsel"</h3>
      <ul class="card-list">
        <li>atmender Tag mit Wechsel von Aktivität und Ruhe</li>
        <li>reizärmere Ruhebereiche</li>
        <li>Rituale vor und nach lauten Phasen</li>
      </ul>

      <h3>Bewegung – „Der Körperkompass"</h3>
      <ul class="card-list">
        <li>tägliche Draußenzeiten</li>
        <li>Barfuß-Strecken, Balancierbalken</li>
        <li>Bewegungslieder und Yoga</li>
      </ul>

      <h3>Ernährung – „Der Bauch-Versteher"</h3>
      <ul class="card-list">
        <li>kleine Beete oder Kräuterecken</li>
        <li>gemeinsame Zubereitung</li>
        <li>sinnliche Erkundung von Lebensmitteln</li>
      </ul>

      <h3>Denken, Fühlen, Wahrnehmen – „Der Staunen-Sammler"</h3>
      <ul class="card-list">
        <li>kleine Stille-Übungen</li>
        <li>Naturbeobachtungen</li>
        <li>Gefühlsrunden im Morgenkreis</li>
      </ul>
    </GlassPanel>
  </Section>

  <Section>
    <GlassPanel class="prose max-w-none">
      <h2>Die Satori-Kaskade</h2>
      <ul class="card-list">
        <li><strong>Fundament</strong> – Körper spüren</li>
        <li><strong>Bewusstsein</strong> – Gefühle benennen</li>
        <li><strong>Regulation</strong> – Werkzeuge nutzen</li>
        <li><strong>Selbstvertrauen</strong> – Wagnis</li>
        <li><strong>Fehlerfreundlichkeit</strong> – „Noch nicht"</li>
        <li><strong>Resilienz</strong> – wieder aufstehen</li>
      </ul>
    </GlassPanel>
  </Section>

  <Section>
    <GlassPanel class="prose max-w-none">
      <h2>Das ganze Dorf</h2>
      
      <h3>Erzieher:innen – den Raum halten</h3>
      <ul class="card-list">
        <li>Fortbildungen zu den fünf Säulen</li>
        <li>Werkzeuge zur eigenen Stressregulation</li>
        <li>Reflexionsräume</li>
      </ul>

      <h3>Eltern – die Brücke nach Hause</h3>
      <ul class="card-list">
        <li>Elternabende und Materialien</li>
        <li>Gemeinsame Sprache für Kita und Zuhause</li>
      </ul>
    </GlassPanel>
  </Section>

  <Section>
    <GlassPanel class="prose max-w-none">
      <h2>Mögliche Formate</h2>
      <ul class="card-list">
        <li>Teamtage / Inhouse-Fortbildungen</li>
        <li>Prozessbegleitung</li>
        <li>Elternabende & Elternmaterialien</li>
        <li>Kinderangebote</li>
      </ul>
    </GlassPanel>
  </Section>

  <Section>
    <GlassPanel class="text-center">
      <Button href="/kontakt" type="primary">Anfrage zu Kindergärten & Eltern</Button>
    </GlassPanel>
  </Section>
</MainLayout>


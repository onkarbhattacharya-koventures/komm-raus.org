---
import MainLayout from '../../layouts/MainLayout.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
import GlassPanel from '../../components/GlassPanel.astro';
import Button from '../../components/Button.astro';
---

<MainLayout title="Fortbildung für Lehrer, Erzieher und Ausbilder – Laubfrosch">
  <Hero title="Fortbildung für Lehrer, Erzieher und Ausbilder" subtitle="Train the Trainer: Natur, Achtsamkeit und Stressregulation im pädagogischen Alltag nutzen." imagePath="/images/bildungseinrichtungen-lehrerfortbildung-feuerbohren-800.jpg" />


  <Section>
    <GlassPanel class="prose max-w-none">
      <h2>Worum es geht</h2>
      <p>Lehrkräfte und pädagogische Fachkräfte stehen unter vielfältigem Druck. Unsere Fortbildungen bieten einen Rahmen, in dem Fachkräfte selbst erleben und ausprobieren können, wie Natur als Lernraum genutzt werden kann.</p>
    </GlassPanel>
  </Section>

  <Section>
    <GlassPanel class="prose max-w-none">
      <h2>Mögliche Schwerpunkte</h2>
      <ul class="card-list">
        <li><strong>Natur als Lernort</strong> – Möglichkeiten und Grenzen von Unterricht im Freien</li>
        <li><strong>Gruppenführung draußen</strong> – Sicherheit, Regeln, Strukturen</li>
        <li><strong>Achtsamkeit und Fokusübungen</strong> – für Schüler und Lehrkräfte</li>
        <li><strong>Stressregulation</strong> – kleine Übungen für Zwischendurch</li>
        <li><strong>BNE in der Praxis</strong> – Boden, Wasser, Ernährung umsetzen</li>
      </ul>
    </GlassPanel>
  </Section>

  <Section>
    <GlassPanel class="prose max-w-none">
      <h2>Arbeitsweise</h2>
      <ul class="card-list">
        <li>kurze thematische Inputs</li>
        <li>praktische Übungen im Waldseilgarten</li>
        <li>Erfahrungsaustausch</li>
        <li>Reflexionsphasen für die eigene Praxis</li>
      </ul>
    </GlassPanel>
  </Section>

  <Section>
    <GlassPanel class="prose max-w-none">
      <h2>Formate & Kooperation</h2>
      <ul class="card-list">
        <li>schulinternen Fortbildungen</li>
        <li>regionale Fortbildungsangebote</li>
        <li>Kooperationen mit Trägern und Schulämtern</li>
      </ul>
    </GlassPanel>
  </Section>

  <Section>
    <GlassPanel class="prose max-w-none">
      <h2>Organisatorisches</h2>
      <ul class="card-list">
        <li><strong>Ort:</strong> Waldseilgarten Laubfrosch</li>
        <li><strong>Dauer:</strong> Halbtages- bis Tagesformate</li>
        <li><strong>Gruppengröße:</strong> klein für mehr Praxisanteil</li>
      </ul>
    </GlassPanel>
  </Section>

  <Section>
    <GlassPanel class="text-center">
      <Button href="/kontakt" type="primary">Anfrage zu Lehrerfortbildung</Button>
    </GlassPanel>
  </Section>
</MainLayout>

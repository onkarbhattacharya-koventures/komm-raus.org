---
import MainLayout from '../../layouts/MainLayout.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
import GlassPanel from '../../components/GlassPanel.astro';
import Button from '../../components/Button.astro';
---

<MainLayout title="Klassenfahrten & Projekttage - Komm Raus">
  <Hero title="Klassenfahrten & Projekttage" subtitle="Gemeinschaft stärken, Natur erleben, Lerninhalte im Draußen verankern." imagePath="/images/bildungseinrichtungen-klassenfahrten-waldseilgarten-laubfrosch-800.jpg" />


  <Section>
    <GlassPanel class="prose max-w-none">
      <h2>Worum es geht</h2>
      <p>Eine Klassenfahrt oder ein Projekttag im Waldseilgarten Laubfrosch bietet einen Rahmen, in dem Schülerinnen und Schüler:</p>
      <ul class="card-list">
        <li>sich in neuen Situationen erleben</li>
        <li>Verantwortung füreinander übernehmen</li>
        <li>Natur direkt erfahren</li>
        <li>und Unterrichtsthemen praktisch anwenden können</li>
      </ul>
    </GlassPanel>
  </Section>

  <Section>
    <GlassPanel class="prose max-w-none">
      <h2>Für wen dieses Angebot geeignet ist</h2>
      <ul class="card-list">
        <li>Grundschulen (ab etwa 3. Klasse)</li>
        <li>Weiterführende Schulen (Sek I/II)</li>
        <li>Berufsschulklassen</li>
        <li>Förderschulen und inklusive Lerngruppen</li>
        <li>Jugendgruppen</li>
      </ul>
    </GlassPanel>
  </Section>

  <Section>
    <GlassPanel class="prose max-w-none">
      <h2>Inhalte & Bausteine</h2>
      
      <h3>Hochseilgarten & Kooperationsaufgaben</h3>
      <ul class="card-list">
        <li>Kletterelemente mit Toprope-Sicherung</li>
        <li>Gegenseitiges Sichern unter Anleitung</li>
        <li>Teamaufgaben am Boden</li>
      </ul>

      <h3>Natur- und Wildnispädagogik</h3>
      <ul class="card-list">
        <li>Orientierung im Wald</li>
        <li>Feuerkunde</li>
        <li>Wildkräuter-Bausteine</li>
        <li>Boden- und BNE-Elemente</li>
      </ul>

      <h3>Resilienz & Selbstregulation (optional)</h3>
      <ul class="card-list">
        <li>Bewegung als Ventil</li>
        <li>Atem- und Ruheübungen</li>
        <li>Wahrnehmungsübungen</li>
      </ul>
    </GlassPanel>
  </Section>

  <Section>
    <GlassPanel class="prose max-w-none">
      <h2>Pädagogische Ziele</h2>
      <ul class="card-list">
        <li>Klassengemeinschaft stärken</li>
        <li>Selbstvertrauen und Mut</li>
        <li>Kommunikation & Konfliktfähigkeit</li>
        <li>Verantwortung & Wagniskompetenz</li>
        <li>Naturverbindung & BNE</li>
      </ul>
    </GlassPanel>
  </Section>

  <Section>
    <GlassPanel class="prose max-w-none">
      <h2>Sicherheit & Verantwortung</h2>
      <ul class="card-list">
        <li>Betrieb nach DIN 15567, ERCA-Standards</li>
        <li>Regelmäßige sicherheitstechnische Prüfungen</li>
        <li>Geschulte Trainer:innen</li>
        <li>Klare Einweisung und Notfallkonzepte</li>
      </ul>
    </GlassPanel>
  </Section>

  <Section>
    <GlassPanel class="prose max-w-none">
      <h2>Formate</h2>
      
      <h3>Projekttage</h3>
      <ul class="card-list">
        <li>Dauer: ½ oder 1 Tag</li>
        <li>Inhalte nach Ziel</li>
      </ul>

      <h3>Klassenfahrten</h3>
      <ul class="card-list">
        <li>2–5 Tage in Kooperation</li>
        <li>Tagesbausteine kombiniert</li>
      </ul>
    </GlassPanel>
  </Section>

  <Section>
    <GlassPanel class="text-center">
      <Button href="/kontakt" type="primary">Anfrage "Klassenfahrten & Projekttage" stellen</Button>
    </GlassPanel>
  </Section>
</MainLayout>


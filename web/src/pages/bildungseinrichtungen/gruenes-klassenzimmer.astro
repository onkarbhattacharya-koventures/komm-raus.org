---
import MainLayout from '../../layouts/MainLayout.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
import GlassPanel from '../../components/GlassPanel.astro';
import Button from '../../components/Button.astro';
---

<MainLayout title="Grünes Klassenzimmer - Komm Raus">
  <Hero title="Grünes Klassenzimmer" subtitle="Lehrplaninhalte haptisch begreifen – Biologie, Nachhaltigkeit und Gesundheit im Freien erleben." imagePath="/images/bildungseinrichtungen-gruenes-klassenzimmer-04-800.jpg" />


  <Section>
    <GlassPanel class="prose max-w-none">
      <h2>Worum es geht</h2>
      <p>Das Grüne Klassenzimmer ist ein außerschulischer Lernort in der Natur, an dem Schülerinnen und Schüler Unterrichtsthemen nicht nur hören oder lesen, sondern mit Händen, Kopf und Körper erleben:</p>
      <ul class="card-list">
        <li>Stoffkreisläufe und Bodenleben werden sichtbar und begreifbar.</li>
        <li>Wasser, Energie, Pflanzen und Tiere werden in ihren Zusammenhängen erfahrbar.</li>
        <li>Ernährung und Gesundheit werden mit dem Boden und den Lebensmitteln vor ihnen verbunden.</li>
      </ul>
    </GlassPanel>
  </Section>

  <Section>
    <GlassPanel class="prose max-w-none">
      <h2>Für wen das Grüne Klassenzimmer gedacht ist</h2>
      <ul class="card-list">
        <li><strong>Grundschulen</strong> – Sachkunde, NaWi, BNE-Schwerpunkte</li>
        <li><strong>Weiterführende Schulen</strong> – Biologie, Erdkunde, Projektfächer</li>
        <li><strong>Förderschulen</strong> – mit angepasster Methodik</li>
        <li><strong>Kitas / Vorschule</strong> – mit starkem Sinnes- und Bewegungsschwerpunkt</li>
      </ul>
    </GlassPanel>
  </Section>

  <Section>
    <GlassPanel class="prose max-w-none">
      <h2>Inhalte & Lernfelder</h2>
      
      <h3>Boden & Stoffkreisläufe</h3>
      <ul class="card-list">
        <li>Wurmfarm / Kompost / Terra Preta</li>
        <li>Vergleich verschiedener Konzepte</li>
        <li>Thema Erosion & Wasserhaushalt</li>
      </ul>

      <h3>Wasser & Energie</h3>
      <ul class="card-list">
        <li>Experimente am Bach</li>
        <li>Wind und Wetter</li>
      </ul>

      <h3>Pflanzen, Ernährung & Gesundheit</h3>
      <ul class="card-list">
        <li>Kräuter- und Gemüsebeete</li>
        <li>Verarbeitungsschritte</li>
        <li>Wildkräuter</li>
      </ul>

      <h3>Tiere & Lebensgemeinschaften</h3>
      <ul class="card-list">
        <li>Beobachtung von Boden- und Kleinstlebewesen</li>
        <li>Spurenlesen, Insekten- und Vogelbeobachtung</li>
      </ul>
    </GlassPanel>
  </Section>

  <Section>
    <GlassPanel class="prose max-w-none">
      <h2>Didaktischer Ansatz: Co-Creation & BNE</h2>
      
      <h3>Co-Creation statt fertigem Programm</h3>
      <p>Klassen und Gruppen sind Mitgestaltende: Sie bauen oder erweitern Stationen, pflegen Beete, entwickeln eigene Fragestellungen.</p>

      <h3>Achtsamkeit und Naturverbindung</h3>
      <p>Regelmäßige kurze Achtsamkeitsübungen helfen, von Alltagshektik in Präsenz zu wechseln.</p>

      <h3>BNE & Kompetenzorientierung</h3>
      <ul class="card-list">
        <li>Kritisches Denken</li>
        <li>Kreativität</li>
        <li>Kollaboration</li>
        <li>Kommunikation</li>
      </ul>
    </GlassPanel>
  </Section>

  <Section>
    <GlassPanel class="prose max-w-none">
      <h2>Warum ein Grünes Klassenzimmer sinnvoll ist</h2>
      <ul class="card-list">
        <li>Lernen in der Natur kann Konzentration, Kreativität und Sozialverhalten positiv beeinflussen</li>
        <li>Regelmäßiger Aufenthalt im Grünen kann Symptome von Unaufmerksamkeit abmildern</li>
        <li>Handlungsorientierte Lernsettings können das Interesse an Naturwissenschaften steigern</li>
      </ul>
    </GlassPanel>
  </Section>

  <Section>
    <GlassPanel class="prose max-w-none">
      <h2>Organisatorisches</h2>
      
      <h3>Mögliche Formate</h3>
      <ul class="card-list">
        <li>Projekttage (½ oder 1 Tag)</li>
        <li>Modulreihen – mehrere Besuche im Jahreslauf</li>
        <li>Kombinationen mit Waldseilgarten, Wildkräuterwanderung</li>
      </ul>

      <h3>Rahmenfaktoren</h3>
      <ul class="card-list">
        <li>Gruppengröße je nach Alter</li>
        <li>Saison: Frühling bis Herbst besonders reich</li>
        <li>An- und Abreiseorganisation durch die Schule</li>
      </ul>
    </GlassPanel>
  </Section>

  <Section>
    <GlassPanel class="text-center">
      <Button href="/kontakt" type="primary">Anfrage "Grünes Klassenzimmer" stellen</Button>
    </GlassPanel>
  </Section>
</MainLayout>


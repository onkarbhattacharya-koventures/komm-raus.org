<script client:load>
  document.addEventListener('DOMContentLoaded', () => {
    const cardItems = document.querySelectorAll('.content-panel li');
    cardItems.forEach((li) => {
      const current = li.innerHTML.trim();
      if (!current || /^<strong/i.test(current)) return;

      const colonIndex = current.indexOf(':');
      if (colonIndex < 2 || colonIndex > 90) return;

      const lead = current.slice(0, colonIndex + 1).trim();
      const rest = current.slice(colonIndex + 1).trim();
      if (!rest) return;

      li.innerHTML = `<strong class="card-lead">${lead}</strong> ${rest}`;
    });

    const button = document.getElementById('adhs-bildung-anfrage-button');
    const modal = document.getElementById('anfrage-modal');

    if (button && modal) {
      button.addEventListener('click', () => {
        modal.classList.add('is-open');
        modal.setAttribute('aria-hidden', 'false');
      });
    }
  });
</script>



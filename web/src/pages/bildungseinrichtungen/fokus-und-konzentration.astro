---
import MainLayout from '../../layouts/MainLayout.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
import Card from '../../components/Card.astro';
import Button from '../../components/Button.astro';
---

<MainLayout title="Fokus & Konzentration – Laubfrosch">
  <Hero
    title="Fokus & Konzentration"
    subtitle="Aufmerksamkeitsräume gestalten und trainieren – im Wald, im Seilgarten und im Alltag."
    imagePath="/images/bildungseinrichtungen-fokus-und-konzentration-kurs-fokus-achtsamkeit-800.jpg"
  />

  <Section>
    <div class="prose max-w-none content-panel">
      <h2>Was Sie bei uns finden</h2>
      <p>Fokus ist eine Grundlage wirksamen Trainings und Lernens.</p>
      <p>Ob es um Bewegung, Teamarbeit, Wildnisfertigkeiten oder das „Soil-to-Table"-Prinzip geht: Ohne Sammlung der Aufmerksamkeit versickern viele Impulse schnell.</p>
      <p>Im Bereich Fokus & Konzentration unterstützen wir:</p>
      <ul class="card-list">
        <li>Teams und Führungskräfte</li>
        <li>Einsatzkräfte</li>
        <li>Lehrkräfte, Schüler:innen und Kitateams</li>
        <li>Einzelpersonen und Familien</li>
      </ul>
      <p>Dabei helfen wir:</p>
      <ul class="card-list">
        <li>zu verstehen, wie Aufmerksamkeit als System funktioniert</li>
        <li>Werkzeuge für Fokus, Pausen und den Umgang mit Ablenkung zu erproben</li>
        <li>einfache Rituale für Alltag, Unterricht und Einsatzpraxis zu entwickeln</li>
      </ul>
    </div>
  </Section>

  <Section>
    <div class="prose max-w-none content-panel">
      <h2>Warum Fokus heute ein Thema ist</h2>
      <ul class="card-list">
        <li><strong>Digitale Reize:</strong> E-Mails, Chats, Benachrichtigungen, Social Media</li>
        <li><strong>Arbeitsdruck:</strong> Mehrfachbelastung und Zeitdruck</li>
        <li><strong>Allgemeiner Stress:</strong> Zu wenig echte Ruhephasen</li>
      </ul>
    </div>
  </Section>

  <Section>
    <div class="prose max-w-none content-panel">
      <h2>Unser Fokus-Framework</h2>
      <div class="cards-grid">
        <Card title="Biologische Basis" body="Schlaf, Bewegung, Ernährung und Nervensystemzustand sind die Grundlage." imagePath="/images/bildungseinrichtungen-fokus-schlaf-resilienzprotokoll-800.jpg" />


        <Card title="Innere Ebene" body="Aufmerksamkeit wandert. Konzentration heißt, freundlich zur Aufgabe zurückzukehren." imagePath="/images/bildungseinrichtungen-fokus-kurs-fokus-monch-800.jpg" />

        <Card title="Kognitive Ebene" body="Das Gehirn arbeitet in Zyklen. Wir nutzen Fokusphasen mit echten Pausen." imagePath="/images/bildungseinrichtungen-fokus-denken-geist-resilienzprotokoll-800.jpg" />

        <Card title="Verhalten & Umgebung" body="Routinen und reizärmere Lernorte entlasten Willenskraft." imagePath="/images/bildungseinrichtungen-fokus-gruenes-klassenzimmer-04-800.jpg" />

      </div>
    </div>
  </Section>

  <Section>
    <div class="prose max-w-none content-panel">
      <h2>Fokus in unseren Praxisformaten</h2>
      <div class="cards-grid">
        <Card title="Soil to Table" body="Konzentration im Tun: schneiden, pflanzen, beobachten." imagePath="/images/bildungseinrichtungen-fokus-soil-table-komm-raus-gmbh-800.jpg" />

        <Card title="Bogenschießen" body="Richtung, Rhythmus und Atmung zeigen unmittelbar, wie kleine Ablenkungen verändern." imagePath="/images/bildungseinrichtungen-fokus-kurs-fokus-800.jpg" />

        <Card title="Bewegung" body="Teilnehmende trainieren Körperwahrnehmung und Spannungssteuerung." imagePath="/images/bildungseinrichtungen-fokus-bewegung-resilienzprotokoll-800.jpg" />

        <Card title="Wildnis & Naturhandwerk" body="Feuer, Schnitzen und Spurensuche fordern Ruhe und Geduld." imagePath="/images/bildungseinrichtungen-fokus-bushcraft-feuer-800.jpg" />

        <Card title="Meditation" body="Stille Übungen trainieren die Rückkehr zum gewählten Fokus." imagePath="/images/bildungseinrichtungen-fokus-meditation-resilienzprotokoll-800.jpg" />

      </div>
    </div>
  </Section>

  <Section>
    <div class="prose max-w-none content-panel">
      <h2>Fokus in Zielgruppen-Angeboten</h2>
      <h3>Für Unternehmen und Teams</h3>
      <ul class="card-list">
        <li>Konzentration unter realer Beanspruchung</li>
        <li>Arbeiten mit Fokusfenstern statt Unterbrechungen</li>
        <li>Routinen für den Alltag</li>
      </ul>
      <h3>Für Schulen und Kitas</h3>
      <ul class="card-list">
        <li>Konzentrations- und Achtsamkeitsübungen in Bewegung</li>
        <li>Aufmerksamkeitsinseln im Schultag</li>
        <li>Verknüpfung mit Naturbeobachtung</li>
      </ul>
    </div>
  </Section>

  <Section>
    <div class="prose max-w-none content-panel">
      <h2>Leitprinzipien</h2>
      <ul class="card-list">
        <li>Aufmerksamkeit ist begrenzt. Wir arbeiten innerhalb biologischer Grenzen.</li>
        <li>Struktur vor Willenskraft. Gute Rahmen entlasten.</li>
        <li>Innere und äußere Auslöser von Ablenkung gehören zusammen.</li>
        <li>Entscheidend ist Übung im Alltag, nicht nur im Seminar.</li>
        <li>Pausen und Erholung sind Teil des Fokus-Systems.</li>
      </ul>
    </div>
  </Section>

  <Section>
    <div class="prose max-w-none content-panel">
      <h2>Grenzen & Einordnung</h2>
      <p>Unsere Arbeit ersetzt keine medizinische oder psychotherapeutische Behandlung. Wir können:</p>
      <ul class="card-list">
        <li>Aufmerksamkeitswissen verständlich machen</li>
        <li>praktische Erfahrungsräume schaffen</li>
        <li>realistische Verbesserungen anstoßen</li>
      </ul>
    </div>
  </Section>

  <Section class="yellow">
    <div class="text-center">
      <Button href="/kontakt" type="primary">Anfrage zu Fokus & Konzentration</Button>
    </div>
  </Section>
</MainLayout>


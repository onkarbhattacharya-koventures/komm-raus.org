<script client:load>
  document.addEventListener('DOMContentLoaded', () => {
    // enhanceLeadBeforeColon functionality - inline
    const selectors = [
      '#worum-es-geht li',
      '#fuer-wen li',
      '#inhalte-aufbau li',
      '#wissenschaft li',
      '#sicherheit-haltung li',
      '#organisatorisches-anfrage li',
    ];
    const selectorText = selectors.join(',');
    const targets = document.querySelectorAll(selectorText);
    targets.forEach((node) => {
      if (node.children.length > 0) return;
      let text = node.textContent?.trim() ?? '';
      if (!text) return;
      const colonIndex = text.indexOf(':');
      if (colonIndex < 2 || colonIndex > 90) return;
      const lead = text.slice(0, colonIndex + 1).trim();
      const rest = text.slice(colonIndex + 1).trim();
      if (!rest) return;
      node.innerHTML = `<strong class="card-lead">${lead}</strong> ${rest}`;
    });

    // Modal trigger
    const button = document.getElementById('adhs-anfrage-button');
    const modal = document.getElementById('anfrage-modal');

    if (button && modal) {
      button.addEventListener('click', () => {
        modal.classList.add('is-open');
        modal.setAttribute('aria-hidden', 'false');
      });
    }
  });
</script>


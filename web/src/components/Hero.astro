---
interface Props {
  title?: string;
  subtitle?: string;
  imagePath?: string;
}

const {
  title = 'Jetzt raus – Erleben',
  subtitle = '',
  imagePath = '/images/lagerfeuer-bg-800.jpg',
} = Astro.props as Props;

// Build responsive srcset for /images/ paths that follow the -800.jpg naming convention
const imagesMatch = imagePath.match(/^(\/images\/.+)-800\.jpg$/);
const webpSrcset = imagesMatch ? `${imagesMatch[1]}-400.webp 400w, ${imagesMatch[1]}-800.webp 800w` : undefined;
const jpgSrcset = imagesMatch ? `${imagesMatch[1]}-400.jpg 400w, ${imagesMatch[1]}-800.jpg 800w` : undefined;
---

<section class="hero-section">
  <picture aria-hidden="true" class="hero-bg">
    {webpSrcset && <source type="image/webp" srcset={webpSrcset} sizes="100vw" />}
    <img
      src={imagePath}
      srcset={jpgSrcset}
      sizes="100vw"
      alt=""
      class="hero-bg-img"
      loading="eager"
      decoding="async"
    />
  </picture>

  <div class="container">
    <div class="hero-text-sheen">
      <h1 class="hero-title">{title}</h1>
      {subtitle && <p class="hero-subtitle">{subtitle}</p>}
    </div>
  </div>
</section>

<style>
.hero-text-sheen {
  display: inline-block;
  background: rgba(0, 0, 0, 0.1);
  border-radius: 0.75rem;
  padding: clamp(0.4rem, 1.2vw, 0.7rem) clamp(0.55rem, 1.5vw, 0.95rem);
  backdrop-filter: blur(1.5px);
  -webkit-backdrop-filter: blur(1.5px);
}
</style>

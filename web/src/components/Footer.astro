---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-content">
      <!-- Logo & Contact -->
      <div class="footer-section animate-fade-in">
        <div class="footer-title">Komm Raus</div>
        <p class="footer-text">Laubfrosch Waldseilgarten</p>
        <p class="footer-text">Erlebnispädagogik & Wildnispädagogik</p>
        <p class="footer-text">Für Kinder, Jugendliche & Erwachsene</p>
      </div>

      <!-- Quick Links -->
      <div class="footer-section animate-fade-in animation-delay-200">
        <h3 class="footer-heading">Navigation</h3>
        <ul class="footer-links">
          <li><a href="/bildungseinrichtungen" class="footer-link">Bildungseinrichtungen</a></li>
          <li><a href="/unternehmen" class="footer-link">Unternehmen</a></li>
          <li><a href="/einsatzkraefte" class="footer-link">Einsatzkräfte</a></li>
          <li><a href="/erlebnisse-kurse" class="footer-link">Erlebnisse</a></li>
<li><a href="/info-orga" class="footer-link">Info & Orga</a></li>
          <li><a href="/kontakt" class="footer-link">Kontakt</a></li>
        </ul>
      </div>

      <!-- Contact & Social -->
      <div class="footer-section animate-fade-in animation-delay-400">
        <h3 class="footer-heading">Kontakt</h3>
        <p class="footer-text">📧 info@komm-raus.org</p>
        <p class="footer-text">📞 +49 (0) 170 - 47 97 822</p>
        <p class="footer-text">📍 Richard-Schirrmann-Weg 2, 63654 Büdingen, Deutschland</p>

        <!-- Social Links (placeholder) -->
        <div class="footer-social">
          <a href="#" class="footer-social-link" aria-label="Facebook">📘</a>
          <a href="#" class="footer-social-link" aria-label="Instagram">📷</a>
          <a href="#" class="footer-social-link" aria-label="YouTube">📺</a>
        </div>
      </div>
    </div>

    <!-- Copyright -->
    <div class="footer-bottom animate-fade-in animation-delay-600">
      <p>© {currentYear} Komm Raus. Alle Rechte vorbehalten.</p>
      <p class="footer-legal">
        <a href="/kontakt/impressum" class="footer-link">Impressum</a> |
        <a href="/kontakt/datenschutz" class="footer-link">Datenschutz</a> |
        <a href="/kontakt/agb" class="footer-link">AGB</a> |
        <a href="/info-orga/sitemap" class="footer-link">Sitemap</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .animate-fade-in {
    animation: fadeIn 0.6s ease-out forwards;
    opacity: 0;
  }

  .animation-delay-200 {
    animation-delay: 0.2s;
  }

  .animation-delay-400 {
    animation-delay: 0.4s;
  }

  .animation-delay-600 {
    animation-delay: 0.6s;
  }

  @keyframes fadeIn {
    to {
      opacity: 1;
    }
  }
</style>

---
interface Props {
  title: string;
  body?: string;
  imagePath?: string;
  imageAlt?: string;
  href?: string;
  class?: string;
}

const {
  title,
  body = '',
  imagePath,
  imageAlt,
  href,
  class: className = '',
} = Astro.props as Props;

const alt = imageAlt ?? title;
---

<article class={`card ${className}`.trim()}>
  {imagePath && (
    <img
      src={imagePath}
      alt={alt}
      class="card-image"
      loading="lazy"
      decoding="async"
    />
  )}

  <div class="card-content">
    <h3 class="card-title">{title}</h3>
    {body && <p class="card-body" set:html={body}></p>}
    {href && <a href={href} class="btn btn-primary btn-sm">Details</a>}
  </div>
</article>

---
interface Props {
  href?: string;
  type?: 'primary' | 'secondary' | 'dark' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}
const { href = '#', type = 'primary', size = 'md', class: className = '' } = Astro.props as Props;

const sizeClasses = {
  sm: 'btn-sm',
  md: 'btn-md',
  lg: 'btn-lg'
};
---

<a 
  href={href} 
  class={`btn btn-${type} ${sizeClasses[size]} ${className}`}
>
  <slot />
</a>

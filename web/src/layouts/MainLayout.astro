---
import '../styles/design-system.css';
import '../styles/global.css';
import { buildMeta } from '../lib/site';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import AnfrageModal from '../components/AnfrageModal.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const { title = 'komm-raus.org', description, image } = Astro.props as Props;
const meta = buildMeta({ title, description, image });
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content={meta.description} />
    <link rel="icon" href="/favicon.svg" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@400;700&display=swap" rel="stylesheet">

    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:image" content={meta.image} />
    <meta property="og:url" content={meta.url} />
    <meta name="twitter:card" content="summary_large_image" />

    <title>{meta.title}</title>
  </head>
  <body>
    <Navigation />

    <main>
      <slot />
    </main>

    <Footer />

    <!-- AOS init (client-only) -->
    <script type="module">
      import AOS from 'aos';
      import 'aos/dist/aos.css';
      AOS.init({
        duration: 600,
        easing: 'ease-in-out',
        once: true,
        offset: 50
      });
    </script>

    <!-- Accordion functionality for all h2 headings -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        // Accordion functionality for all h2 headings
        const h2s = document.querySelectorAll('h2');
        h2s.forEach(h2 => {
          // Skip headings that are already part of a manually-authored accordion.
          if (h2.closest('summary') || h2.closest('details')) return;

          const section = h2.closest('section');
          if (!section) return;
          section.classList.add('auto-accordion-section');
          const details = document.createElement('details');
          const summary = document.createElement('summary');
          summary.innerHTML = h2.innerHTML;
          details.appendChild(summary);

          const contentDiv = document.createElement('div');
          contentDiv.className = 'accordion-content';
          details.appendChild(contentDiv);

          // Move all content after the h2 until the next h2 or end of section
          let sibling = h2.nextSibling;
          while (sibling) {
            const nextSibling = sibling.nextSibling;
            if (sibling.nodeType === 1 && sibling.tagName === 'H2') {
              break;
            }
            contentDiv.appendChild(sibling);
            sibling = nextSibling;
          }

          h2.parentNode.replaceChild(details, h2);

          const panel = details.closest('.glass-panel, .content-panel');
          if (panel) {
            panel.classList.add('accordion-panel');
          }
        });
      });
    </script>

    <AnfrageModal />
  </body>
</html>
